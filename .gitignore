# Copyrighted source material: cited by page, never redistributed.
# Bishop, Okinawan Karate; Nagamine, Tales of Okinawa's Great Masters;
# Cramer, The History of Karate; Guarelli, Okinawan Kobudo.
*.pdf
*.epub
*.mobi
*.azw3
books/*.txt

# The Netlify Drop folder: byte-identical to docs/, which is what GitHub Pages
# serves. Kept on disk by the build, but no need for two copies in the repo.
website/

# The passphrase for the gated /hutan build. The encrypted page is committed;
# the key to it is not. Lose this file and the passphrase is unrecoverable:
# generate a new one and rebuild, which republishes under the new key.
pipeline/curator_key.txt

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Python
__pycache__/
*.pyc
.venv/
